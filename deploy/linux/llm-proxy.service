[Unit]
Description=LLM Proxy Service
Documentation=https://github.com/acshmily/llm-proxy
After=network.target

[Service]
Type=simple
User=llm-proxy
Group=llm-proxy
WorkingDirectory=/opt/llm-proxy
ExecStart=/opt/llm-proxy/proxy -config /opt/llm-proxy/config.yaml
Restart=on-failure
RestartSec=5s

# 日志配置
StandardOutput=journal
StandardError=journal
SyslogIdentifier=llm-proxy

# 安全限制
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/opt/llm-proxy/logs

# 资源限制
LimitNOFILE=65535
LimitNPROC=4096

# 环境变量
Environment="PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment="TZ=Asia/Shanghai"

[Install]
WantedBy=multi-user.target
